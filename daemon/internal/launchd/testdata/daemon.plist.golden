<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.zahidnoor7.mergelane.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/io.github.zahidnoor7.mergelane.daemon</string>
		<string>run</string>
		<string>--allowed-uid</string>
		<string>501</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>1</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/Library/Logs/Mergelane/daemon.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/Mergelane/daemon.log</string>
	<key>AssociatedBundleIdentifiers</key>
	<string>io.github.zahidnoor7.mergelane</string>
</dict>
</plist>
