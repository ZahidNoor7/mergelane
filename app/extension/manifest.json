{
  "manifest_version": 3,
  "name": "Download with Mergelane",
  "short_name": "Mergelane",
  "version": "1.0.0",
  "key": "",
  "description": "Send downloads from your browser to Mergelane Download Manager.",
  "homepage_url": "https://github.com/ZahidNoor7/mergelane",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Mergelane",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "downloads",
    "contextMenus",
    "cookies",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": ["<all_urls>"]
}
