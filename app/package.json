{
  "name": "mergelane",
  "version": "0.6.0",
  "description": "Download manager for macOS that combines every internet connection the Mac has",
  "main": "./out/main/index.js",
  "author": "Mergelane contributors",
  "homepage": "https://github.com/ZahidNoor7/mergelane",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "typecheck:extension": "tsc -p extension/tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e && npm run typecheck:extension",
    "prestart": "install-electron",
    "start": "electron-vite preview",
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "patch-package && install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win --x64 --config electron-builder.win.yml --publish never && electron-builder --win --arm64 --config electron-builder.win.yml --publish never",
    "build:win:dir": "electron-vite build && electron-builder --win --dir --x64 --arm64 --config electron-builder.win.yml --publish never",
    "build:extension": "node extension/build.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "fetch:media-tools": "node ../scripts/media-tools/fetch.mjs",
    "fetch:media-tools:win": "node ../scripts/media-tools/fetch.mjs --manifest ../scripts/media-tools/tools-windows-x64.json resources/bin-win/x64 && node ../scripts/media-tools/fetch.mjs --manifest ../scripts/media-tools/tools-windows-arm64.json resources/bin-win/arm64"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "bittorrent-peerid": "2.0.2",
    "fs-chunk-store": "5.0.1",
    "koffi": "^2.16.4",
    "parse-torrent": "11.0.24",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fast-check": "^4.11.0",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.78.0",
    "patch-package": "8.0.1",
    "prettier": "^3.9.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true,
    "koffi@2.16.4": true,
    "node-datachannel@0.32.3": true
  }
}
